<?xml version="1.0" encoding="utf-8"?>
<!--
  Khata MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build khata.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut. The installer shows the
  standard WiX dialogs: welcome + license, progress, and a finish page.

  UpgradeCode and the component GUIDs below belong to Khata alone. Never copy them from (or
  into) a sibling Craft app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other. packaging-lint.yml checks this.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Khata"
      Manufacturer="NH Prince Pradhan"
      Version="$(var.Version)"
      UpgradeCode="48F6EDEB-8BFC-4114-9FE2-19C324C085F9"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Khata word processor" Manufacturer="NH Prince Pradhan" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Khata is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="KhataIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="KhataIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://nhprince.me" />
    <Property Id="ARPURLUPDATEINFO" Value="https://nhprince.me" />
    <Property Id="ARPHELPLINK" Value="https://nhprince.me" />

    <!-- Installer UI (#198): WixUI_Minimal is welcome + license, progress, then a finish page so
         people can see the install worked. Its dialogs and bitmaps are WiX's own
         (WixToolset.UI.wixext); package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch Khata (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <!-- Scrapbook artwork for the wizard (generated by packaging/windows/make-installer-art.py). -->
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)installer-dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)installer-banner.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Khata" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#KhataExe]" />
    <CustomAction Id="LaunchKhata" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchKhata"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Khata" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Khata" Level="1">
      <ComponentGroupRef Id="KhataFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="KhataFiles" Directory="INSTALLFOLDER">
      <Component Id="KhataApp" Guid="0911E56F-2CFC-4F6F-9A97-208C007726F1">
        <File Id="KhataExe" Source="$(var.BinDir)\khata.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Khata"
              Description="Khata word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="KhataIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\khata.exe" Value="[#KhataExe]" Type="string" />
      </Component>

      <!-- File associations (#295). Each document type gets a Khata ProgId (name, icon, open
           command) and is listed under the extension's OpenWithProgids, so Khata shows in
           Explorer's "Open with". The Word, RTF and ODT types are also Khata's Capabilities
           (RegisteredApplications), so it appears in Settings › Default apps, where the user
           makes it the default (File › Options › General opens that page). Nothing here sets an
           extension's default: the installer never takes over .docx from another app. Markdown and
           plain text are only "Open with" candidates. Removed again on uninstall. -->
      <Component Id="KhataFileTypes" Guid="DE1E2EA4-95F3-4565-AA3E-ED7C43DEBB1E">
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="Khata" Value="Software\Khata\Capabilities" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Khata\Capabilities" Name="ApplicationName" Value="Khata" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Khata\Capabilities" Name="ApplicationDescription" Value="Write and design documents; open and save Word files." Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Khata\Capabilities" Name="ApplicationIcon" Value="&quot;[#KhataExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\khata.exe" Name="FriendlyAppName" Value="Khata" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\khata.exe\shell\open\command" Value="&quot;[#KhataExe]&quot; &quot;%1&quot;" Type="string" />

        <ProgId Id="Khata.Document" Description="Khata Document" Icon="KhataExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Khata.Document\shell\open\command" Value="&quot;[#KhataExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docx\OpenWithProgids" Name="Khata.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\khata.exe\SupportedTypes" Name=".docx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Khata\Capabilities\FileAssociations" Name=".docx" Value="Khata.Document" Type="string" />

        <ProgId Id="Khata.DocumentMacroEnabled" Description="Khata Macro-Enabled Document" Icon="KhataExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Khata.DocumentMacroEnabled\shell\open\command" Value="&quot;[#KhataExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.docm\OpenWithProgids" Name="Khata.DocumentMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\khata.exe\SupportedTypes" Name=".docm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Khata\Capabilities\FileAssociations" Name=".docm" Value="Khata.DocumentMacroEnabled" Type="string" />

        <ProgId Id="Khata.Template" Description="Khata Template" Icon="KhataExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Khata.Template\shell\open\command" Value="&quot;[#KhataExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotx\OpenWithProgids" Name="Khata.Template" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\khata.exe\SupportedTypes" Name=".dotx" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Khata\Capabilities\FileAssociations" Name=".dotx" Value="Khata.Template" Type="string" />

        <ProgId Id="Khata.TemplateMacroEnabled" Description="Khata Macro-Enabled Template" Icon="KhataExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Khata.TemplateMacroEnabled\shell\open\command" Value="&quot;[#KhataExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dotm\OpenWithProgids" Name="Khata.TemplateMacroEnabled" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\khata.exe\SupportedTypes" Name=".dotm" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Khata\Capabilities\FileAssociations" Name=".dotm" Value="Khata.TemplateMacroEnabled" Type="string" />

        <ProgId Id="Khata.LegacyDocument" Description="Legacy Khata Document" Icon="KhataExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Khata.LegacyDocument\shell\open\command" Value="&quot;[#KhataExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.doc\OpenWithProgids" Name="Khata.LegacyDocument" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\khata.exe\SupportedTypes" Name=".doc" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Khata\Capabilities\FileAssociations" Name=".doc" Value="Khata.LegacyDocument" Type="string" />

        <ProgId Id="Khata.LegacyTemplate" Description="Legacy Khata Template" Icon="KhataExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Khata.LegacyTemplate\shell\open\command" Value="&quot;[#KhataExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.dot\OpenWithProgids" Name="Khata.LegacyTemplate" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\khata.exe\SupportedTypes" Name=".dot" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Khata\Capabilities\FileAssociations" Name=".dot" Value="Khata.LegacyTemplate" Type="string" />

        <ProgId Id="Khata.RichText" Description="Rich Text Document" Icon="KhataExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Khata.RichText\shell\open\command" Value="&quot;[#KhataExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.rtf\OpenWithProgids" Name="Khata.RichText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\khata.exe\SupportedTypes" Name=".rtf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Khata\Capabilities\FileAssociations" Name=".rtf" Value="Khata.RichText" Type="string" />

        <ProgId Id="Khata.OpenDocumentText" Description="OpenDocument Text" Icon="KhataExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Khata.OpenDocumentText\shell\open\command" Value="&quot;[#KhataExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.odt\OpenWithProgids" Name="Khata.OpenDocumentText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\khata.exe\SupportedTypes" Name=".odt" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Khata\Capabilities\FileAssociations" Name=".odt" Value="Khata.OpenDocumentText" Type="string" />

        <ProgId Id="Khata.Markdown" Description="Markdown Document" Icon="KhataExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Khata.Markdown\shell\open\command" Value="&quot;[#KhataExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids" Name="Khata.Markdown" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\khata.exe\SupportedTypes" Name=".md" Value="" Type="string" />

        <ProgId Id="Khata.PlainText" Description="Text Document" Icon="KhataExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Khata.PlainText\shell\open\command" Value="&quot;[#KhataExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.txt\OpenWithProgids" Name="Khata.PlainText" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\khata.exe\SupportedTypes" Name=".txt" Value="" Type="string" />
      </Component>

      <Component Id="KhataCli">
        <File Id="KhataCliExe" Source="$(var.BinDir)\khata-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
